{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "prefab-transform-override-fixer",
    "version": "1.0.0",
    "author": "Yueby",
    "editor": ">=3.8.3",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc",
        "watch": "tsc -w"
    },
    "description": "i18n:prefab-transform-override-fixer.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.3",
        "@types/node": "^18.17.1",
        "typescript": "^4.3.4"
    },
    "contributions": {
        "messages": {
            "scene:ready": {
                "methods": [
                    "onSceneReady"
                ]
            },
            "scene:close": {
                "methods": [
                    "onSceneClose"
                ]
            },
            "scene:add-node": {
                "methods": [
                    "onSceneAddNode"
                ]
            },
            "scene:change-node": {
                "methods": [
                    "onSceneChangeNode"
                ]
            },
            "scene:remove-node": {
                "methods": [
                    "onSceneRemoveNode"
                ]
            }
        }
    }
}
